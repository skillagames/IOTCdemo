rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Optional: Use this only for sensitive write operations if requested
    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.email.matches('.*@test\\.com') || request.auth.token.email == 'admin@test.com');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && 
             (
               request.auth.token.email.matches('admin@.*') ||
               request.auth.token.email == 'admin@test.com' ||
               (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
             );
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.role in ['user', 'admin'];
    }

    function isValidDevice(data) {
      return data.serialNumber is string && data.serialNumber.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.ownerId is string &&
             data.subscriptionStatus in ['active', 'expired', 'inactive'];
    }

    function isValidUsage(data) {
      return data.dataUsedMb is number && data.dataUsedMb >= 0 &&
             data.activeHours is number && data.activeHours >= 0;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && 
                     incoming().keys().hasAll(['uid', 'role', 'createdAt']) &&
                     isValidUser(incoming()) &&
                     (
                       incoming().get('role', 'user') == 'user' ||
                       (isAdmin() && incoming().get('role', 'user') == 'admin')
                     );
      
      allow update: if (isOwner(userId) || isAdmin()) && 
                     isVerified() &&
                     (
                       // Action: User self-update
                       (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'showInsights', 'photoURL', 'fcmToken', 'tokenSource', 'lastTokenUpdate', 'phoneNumber', 'address', 'lastLogin', 'tokenUpdatedAt', 'updatedAt'])) ||
                       // Action: Admin Management
                       (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'displayName', 'showInsights', 'updatedAt']))
                     );
    }

    match /devices/{deviceId} {
      allow get: if isSignedIn() && isValidId(deviceId) && (existing().get('ownerId', '') == request.auth.uid || isAdmin());
      
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      allow create: if isVerified() && isValidId(deviceId) && 
                     incoming().keys().hasAll(['serialNumber', 'name', 'ownerId', 'subscriptionStatus', 'lastUpdated']) &&
                     isValidDevice(incoming()) && 
                     incoming().ownerId == request.auth.uid;
      
      allow update: if isVerified() && isValidId(deviceId) && (existing().get('ownerId', '') == request.auth.uid || isAdmin()) &&
                     (
                       // Ensure identity and immutability
                       (isAdmin() || incoming().get('ownerId', existing().ownerId) == existing().ownerId) &&
                       // Action: Update details/status
                       (incoming().diff(existing()).affectedKeys().hasAny(['name', 'subscriptionStatus', 'lastUpdated', 'expirationDate', 'autoRenew', 'description']))
                     );
      
      allow delete: if isVerified() && isValidId(deviceId) && (existing().get('ownerId', '') == request.auth.uid || isAdmin());

      // Nested Usage Stats
      match /usage/{statId} {
        allow list: if isSignedIn() && exists(/databases/$(database)/documents/devices/$(deviceId)) && get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerId == request.auth.uid;
        allow list: if isAdmin();
        
        allow get: if isSignedIn() && isValidId(statId) && exists(/databases/$(database)/documents/devices/$(deviceId)) && get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerId == request.auth.uid;
        allow get: if isAdmin() && isValidId(statId);
        
        allow create: if isSignedIn() && isValidId(statId) && 
                       existsAfter(/databases/$(database)/documents/devices/$(deviceId)) &&
                       getAfter(/databases/$(database)/documents/devices/$(deviceId)).data.ownerId == request.auth.uid &&
                       isValidUsage(incoming());
        allow create: if isAdmin() && isValidId(statId) && isValidUsage(incoming());
        
        allow delete: if isSignedIn() && exists(/databases/$(database)/documents/devices/$(deviceId)) && get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /master_registry/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
